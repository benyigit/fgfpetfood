
# Community accounts: local development uses the ignored .community/ folder.
# A persistent database + private object storage adapter is required for Vercel.
# Never point this folder at public/.
# COMMUNITY_DATA_DIR=/absolute/private/persistent/community
# COMMUNITY_ORIGIN=https://your-site.example

# Shopify Storefront API: server-only. No NEXT_PUBLIC_ prefix.
# Use the permanent *.myshopify.com domain, without https:// or a path.
SHOPIFY_STORE_DOMAIN=
# Configure one token type. Private tokens take precedence when both exist.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=
# Production community: Neon database + PRIVATE Vercel Blob, server-only.
# Connect the stores through Vercel to populate these values. Never use NEXT_PUBLIC_.
DATABASE_URL=
BLOB_STORE_ID=
# Optional legacy Blob token; OIDC is preferred on Vercel.
BLOB_READ_WRITE_TOKEN=

# Public canonical origin. Set this when moving to your final domain.
SITE_URL=https://fgfpetfood.vercel.app
