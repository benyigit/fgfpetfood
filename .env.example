
# Community accounts: local development uses the ignored .community/ folder.
# A persistent database + private object storage adapter is required for Vercel.
# Never point this folder at public/.
# COMMUNITY_DATA_DIR=/absolute/private/persistent/community
# COMMUNITY_ORIGIN=https://your-site.example

# Shopify Storefront API: server-only. No NEXT_PUBLIC_ prefix.
# Use the permanent *.myshopify.com domain, without https:// or a path.
SHOPIFY_STORE_DOMAIN=
# Configure one token type. Private tokens take precedence when both exist.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_ACCESS_TOKEN=
# Production community: Neon database + PRIVATE Vercel Blob, server-only.
# Connect the stores through Vercel to populate these values. Never use NEXT_PUBLIC_.
DATABASE_URL=
BLOB_STORE_ID=
# Optional legacy Blob token; OIDC is preferred on Vercel.
BLOB_READ_WRITE_TOKEN=

# Public canonical origin. Set this when moving to your final domain.
SITE_URL=https://fgfpetfood.vercel.app

# Optional Shopify Admin API access for studio import and DRAFT creation. Server-only.
# Install the app on the shared Shopify store with write_products (includes read_products).
SHOPIFY_ADMIN_ACCESS_TOKEN=

# AI studio: server-only OpenAI project credentials. Generation is optional and paid by that API project.
# Choose a Responses API model supporting structured outputs; no credentials are exposed publicly.
OPENAI_API_KEY=
OPENAI_MODEL=

# Social publishing: credentials for THIS BRAND's authorized Facebook Page / linked Instagram account.
# Do not use NEXT_PUBLIC_, personal consumer-account tokens, or another brand's account IDs.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_API_VERSION=v26.0
# Optional app-secret proof when required by the Meta app.
META_APP_SECRET=
# Exact public HTTPS website origin (no path); Meta must be able to fetch published CMS media.
SOCIAL_PUBLIC_ORIGIN=
